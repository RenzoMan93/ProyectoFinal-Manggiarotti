rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Product photos are public (they're shown in the feed to anyone,
    // logged in or not) but only the owner can upload/replace their own.
    match /products/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 12 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // KYC documents/selfies are sensitive — only the owner (client-side)
    // and the Cloud Functions Admin SDK (server-side, bypasses these
    // rules) can ever read them.
    match /kyc/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 12 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
