# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored - never commit real credentials.

# Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=TU_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=TU_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=TU_PROJECT_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=TU_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=TU_APP_ID

# Cloudinary console -> Settings -> Upload -> Upload presets (create one with
# Signing Mode "Unsigned"). Free tier, no card required, used for product
# photos and KYC document/selfie uploads instead of Firebase Storage.
VITE_CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=TU_UPLOAD_PRESET
