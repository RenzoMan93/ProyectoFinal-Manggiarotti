rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles are never read cross-user by this client (product/chat/order
    // docs carry their own denormalized name/verified snapshot), so a
    // profile is only ever visible to its owner.
    match /users/{uid} {
      allow read, create: if request.auth != null && request.auth.uid == uid;

      // A user can update their own profile, but cannot promote themselves
      // straight to "verified" — that transition is only ever written by
      // the Cloud Functions Admin SDK (see functions/index.js), which
      // bypasses these rules entirely. Clients may only leave it unchanged
      // or move it to "pending" (see submitKycDocuments).
      allow update: if request.auth != null && request.auth.uid == uid &&
        (request.resource.data.verificationStatus == resource.data.verificationStatus ||
         request.resource.data.verificationStatus == 'pending');

      // Saved listings — only the owner ever reads or writes their own list.
      match /favorites/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public mirror of a seller's aggregate rating (see functions/index.js
    // applyReview). No client write rule at all — this collection is only
    // ever written by the Admin SDK, which bypasses these rules entirely.
    match /sellers/{sellerId} {
      allow read: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // A review must correspond to a real order the buyer actually placed
      // with that exact seller/product — cross-checked against the order
      // doc itself so a buyer can't fabricate a rating out of thin air.
      // Reviews are immutable once created (no update/delete rule).
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.buyerId &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.buyerId == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.sellerId == request.resource.data.sellerId &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.productId == request.resource.data.productId;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == 'active';
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.sellerId;

      // Seller-only data that never belongs on the public product doc:
      // "location" is the exact address + map pin (setProductLocation),
      // "vehicleDeclaration" is the sworn ownership statement required for
      // vehicle listings (setVehicleDeclaration). Buyers never read either
      // — the product doc above only ever exposes city/neighborhood.
      match /private/{docId} {
        allow read, write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/products/$(productId)).data.sellerId;
      }
    }

    match /conversations/{conversationId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.buyerId &&
        request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'assistant');
      }
    }

    match /orders/{orderId} {
      allow read, update: if request.auth != null &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.buyerId;
    }
  }
}
