rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles are never read cross-user by this client (product/chat/order
    // docs carry their own denormalized name/verified snapshot), so a
    // profile is only ever visible to its owner.
    match /users/{uid} {
      allow read, create: if request.auth != null && request.auth.uid == uid;

      // A user can update their own profile, but cannot promote themselves
      // straight to "verified" — that transition is only ever written by
      // the Cloud Functions Admin SDK (see functions/index.js), which
      // bypasses these rules entirely. Clients may only leave it unchanged
      // or move it to "pending" (see submitKycDocuments).
      allow update: if request.auth != null && request.auth.uid == uid &&
        (request.resource.data.verificationStatus == resource.data.verificationStatus ||
         request.resource.data.verificationStatus == 'pending');
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == 'active';
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.sellerId;

      // Exact address + map pin (see productsService.js setProductLocation).
      // Kept out of the public product doc on purpose, for the seller's
      // safety — only the seller can read or write it. Buyers only ever
      // see city/neighborhood, which live on the product doc above.
      match /private/location {
        allow read, write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/products/$(productId)).data.sellerId;
      }
    }

    match /conversations/{conversationId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.buyerId &&
        request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'assistant');
      }
    }

    match /orders/{orderId} {
      allow read, update: if request.auth != null &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.buyerId;
    }
  }
}
