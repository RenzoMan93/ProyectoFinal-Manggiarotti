rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read: if true;
      allow create: if esDueno(uid);
      allow update: if esDueno(uid) ||
        // permitir que la transaccion de rating actualice solo el promedio/contador
        (estaAutenticado() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ratingPromedio', 'cantidadRatings']));
      allow delete: if false;
    }

    match /publicaciones/{id} {
      allow read: if true;
      allow create: if estaAutenticado() && request.resource.data.vendedorId == request.auth.uid;
      allow update: if estaAutenticado() && resource.data.vendedorId == request.auth.uid;
      allow delete: if estaAutenticado() && resource.data.vendedorId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read, update: if estaAutenticado() && request.auth.uid in resource.data.participantes;
      allow create: if estaAutenticado() && request.auth.uid in request.resource.data.participantes;

      match /mensajes/{mensajeId} {
        allow read: if estaAutenticado() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
        allow create: if estaAutenticado() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes &&
          request.resource.data.emisorId == request.auth.uid;
      }
    }

    match /ratings/{id} {
      allow read: if true;
      allow create: if estaAutenticado() &&
        request.resource.data.deId == request.auth.uid &&
        request.resource.data.paraId != request.auth.uid;
      allow update, delete: if false;
    }

    match /busquedasGuardadas/{id} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado() && request.resource.data.usuarioId == request.auth.uid;
      allow delete: if estaAutenticado() && resource.data.usuarioId == request.auth.uid;
      allow update: if false;
    }

    match /notificaciones/{id} {
      allow read: if estaAutenticado() && resource.data.usuarioId == request.auth.uid;
      allow create: if estaAutenticado();
      allow update: if estaAutenticado() && resource.data.usuarioId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow delete: if false;
    }
  }
}
